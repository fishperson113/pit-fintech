# Optional local/deployment overrides. The committed non-secret defaults live in config.yaml.
# Environment variables take precedence over config.yaml and are useful for CI, Docker, or a
# machine-specific deployment. Copy this file to .env only when local overrides are needed.

# Runtime/deployment overrides
# PIT_API_HOST=0.0.0.0
# PIT_API_PORT=8000
# PIT_REDIS_URL=redis://localhost:6379/0
# PIT_MLFLOW_TRACKING_URI=http://localhost:5000
# PIT_OTEL_ENDPOINT=http://<collector-host>:4318
# PIT_LOG_LEVEL=INFO
# PIT_LOG_JSON=false

# Dataset override. Raw data remains gitignored.
# PIT_DATASET=paysim
# PIT_PAYSIM_CSV=./data/raw/paysim/PS_20174392719_1491204439457_log.csv

# Dataset credentials: keep real values out of the repository.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_API_TOKEN=

# Operational flags that are intentionally environment-only because they control one invocation.
# PIT_NOTEBOOK_RUN_TRAINING=0
# PIT_REQUIRE_TRAINING=0
