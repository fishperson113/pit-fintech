# Copy to .env for local overrides. Never commit the real .env.

# Paths
PIT_PROJECT_ROOT=.
PIT_DATA_ROOT=./data
PIT_ARTIFACT_ROOT=./artifacts
PIT_DATASET=sample
PIT_PAYSIM_CSV=./data/raw/paysim/PS_20174392719_1491204439457_log.csv
# Versioned contracts
PIT_ENTITY_DEFINITION_VERSION=paysim-destination-customer-v1
PIT_FEATURE_DEFINITION_VERSION=paysim-fraud-recipient-v2
PIT_FEATURE_SERVICE_VERSION=paysim-fraud-scoring-v2
PIT_FLOAT_TOLERANCE=1e-6

# Local services
PIT_REDIS_URL=redis://localhost:6379/0
PIT_MLFLOW_TRACKING_URI=http://localhost:5000
# Bind host/port for the scoring API. 127.0.0.1 = local-only. Set PIT_API_HOST=0.0.0.0 (and open
# the port on the Tailscale interface) so a remote Prometheus can scrape /metrics, e.g. from a
# VPS at its Tailscale IP: http://<this-machine-tailscale-ip>:8000/metrics
PIT_API_HOST=127.0.0.1
PIT_API_PORT=8000
PIT_JUPYTER_PORT=8888
PIT_JUPYTER_TOKEN=pit-local
PIT_LOG_LEVEL=INFO
PIT_LOG_JSON=false

# Dataset access. Raw data remains gitignored.
KAGGLE_DATASET=ealaxi/paysim1
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# OpenTelemetry (self-hosted OTel Collector, OTLP/HTTP). Traces are pushed here and forwarded to
# Tempo for Grafana; Prometheus does NOT use this — it scrapes /metrics instead (see
# deploy/vps/README.md). Example: PIT_OTEL_ENDPOINT=http://<vps-tailscale-ip>:4318. Consumed by
# `pit serving up --otel` (and `scripts/locust_parity.py`); an explicit `--otel-endpoint` flag
# overrides it.
PIT_OTEL_ENDPOINT=
