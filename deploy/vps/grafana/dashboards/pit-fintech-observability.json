      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "100 * sum(pit_scoring_latency_ms_count) / clamp_min(sum(pit_scoring_requests_total), 1)", "instant": true, "legendFormat": "success rate", "range": false, "refId": "A"}],
