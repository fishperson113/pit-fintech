# Chuẩn hóa line-ending: mọi file văn bản được lưu trong repo bằng LF,
# bất kể chỉnh sửa trên Windows (CRLF) hay Linux/mount (LF).
# Dập tắt các diff giả kiểu CRLF<->LF mà `git status` từng báo.
* text=auto eol=lf

# Windows-native scripts: giữ CRLF để chạy đúng trên môi trường Windows.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Ép LF rõ ràng cho các định dạng nhạy cảm / chạy trên shell POSIX.
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.sql   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
Makefile text eol=lf

# Notebook: là JSON, chuẩn hóa LF nhưng đánh dấu để bớt nhiễu khi review diff.
*.ipynb text eol=lf

# File nhị phân: không đụng EOL, không cố diff.
*.parquet binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.xlsx     binary
*.pptx     binary
*.docx     binary
*.skops    binary
*.zip      binary
